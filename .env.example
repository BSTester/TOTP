# Optional: set your own 32-byte key in base64-url format.
# If empty, app will create .dev_master_key on first startup for local development usage.
APP_MASTER_KEY=

# Optional: file used when APP_MASTER_KEY is empty. Docker uses /data/.master_key
# so encrypted TOTP secrets remain decryptable after container rebuilds.
APP_MASTER_KEY_FILE=.dev_master_key

# SQLite database path (relative or absolute)
APP_DB_PATH=data.db

# Max upload size for QR image bytes
APP_MAX_UPLOAD_BYTES=2097152

# Cookie name used by web login
APP_WEB_COOKIE_NAME=totp_api_key
